# Backend configuration (all variables use the YTL_ prefix, see backend/app/core/config.py).
# Local dev: scripts/setup-db.ps1 writes real values to %USERPROFILE%\.ytlead-secrets\backend.conf
# and scripts/dev.ps1 points YTL_ENV_FILE at it. Never commit real values.

YTL_ENV=dev

# --- Database ---------------------------------------------------------------
# App role (DML only)
YTL_DATABASE_URL=postgresql+psycopg://ytlead_app:CHANGE_ME@127.0.0.1:5432/ytlead
# Schema owner (Alembic migrations)
YTL_MIGRATION_DATABASE_URL=postgresql+psycopg://ytlead_owner:CHANGE_ME@127.0.0.1:5432/ytlead
# Test database (owner role; tests recreate the schema)
YTL_TEST_DATABASE_URL=postgresql+psycopg://ytlead_owner:CHANGE_ME@127.0.0.1:5432/ytlead_test
YTL_DB_POOL_SIZE=5

# --- Security ---------------------------------------------------------------
# 32 random bytes, base64 (setup-db.ps1 generates it automatically). Manually:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
YTL_MASTER_KEY=
# true behind HTTPS (production)
YTL_COOKIE_SECURE=false
YTL_SESSION_IDLE_MINUTES=720
YTL_SESSION_ABSOLUTE_HOURS=336
YTL_LOGIN_RATE_LIMIT_ATTEMPTS=10
YTL_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# --- Storage ----------------------------------------------------------------
# Default: <project root>/storage
# YTL_STORAGE_PATH=C:\youtubesistemprew\storage
YTL_MAX_UPLOAD_BYTES=10485760

# --- Modes ------------------------------------------------------------------
YTL_DEMO_MODE=false

# --- External providers (empty => "Not configured") --------------------------
YTL_YOUTUBE_API_KEY=
# Discovery provider: api (YouTube Data API v3, needs the key) | mock (offline, demo-labelled data).
# Empty => mock in demo mode, api when YTL_YOUTUBE_API_KEY is set, otherwise "not configured".
YTL_YOUTUBE_PROVIDER=
# Units per Pacific-time day (Google default 10 000 per GCP project); the ledger stops discovery at this limit
YTL_YOUTUBE_DAILY_QUOTA=10000
# Channels fetched more recently than this are not re-fetched by discovery (saves quota)
YTL_YOUTUBE_CHANNEL_REFRESH_HOURS=24
YTL_OPENAI_API_KEY=
YTL_OPENAI_VISION_MODEL=
YTL_OPENAI_IMAGE_MODEL=
YTL_HTTP_TIMEOUT_SECONDS=20
# Thumbnails: http (i.ytimg.com, no quota) | mock (offline demo images). Empty => mock in demo mode, else http
YTL_THUMBNAIL_FETCHER=

# --- Worker (python -m app.workers) -----------------------------------------
YTL_WORKER_CONCURRENCY=2
# total runs incl. the first; only transient errors are retried
YTL_WORKER_RETRY_MAX_ATTEMPTS=5
YTL_WORKER_RETRY_BASE_SECONDS=10
YTL_WORKER_RETRY_MAX_BACKOFF_SECONDS=3600
YTL_WORKER_STALLED_AFTER_SECONDS=60

# --- Logging ----------------------------------------------------------------
YTL_LOG_LEVEL=INFO
YTL_LOG_JSON=true
