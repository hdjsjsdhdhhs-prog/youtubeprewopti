# docker compose variables (infrastructure/docker-compose.yml). Copy to infrastructure/.env and fill in.
# Never commit the real file (.env is git-ignored).
#
# Passwords are embedded in database URLs: use URL-safe characters only (letters, digits, - _ .), e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"

# PostgreSQL superuser (container administration only; the application never uses it)
POSTGRES_PASSWORD=
# Schema owner (migrations) and DML-only application role. Applied on the first start only:
# changing them later requires ALTER ROLE inside the database.
YTL_DB_OWNER_PASSWORD=
YTL_DB_APP_PASSWORD=

# 32 random bytes, base64. Encrypts stored secrets — losing it makes them unreadable.
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
YTL_MASTER_KEY=

# Secure cookies require HTTPS in front of `web` (reverse proxy / TLS terminator).
# Browsers also accept them on http://localhost; set false only for plain-HTTP tests on other hosts.
YTL_COOKIE_SECURE=true

# Where `web` is published. Default: localhost only (put a TLS reverse proxy in front).
YTL_WEB_BIND=127.0.0.1
YTL_WEB_PORT=3000
YTL_IMAGE_TAG=latest

# Internal network. Change only if 172.30.57.0/24 collides with a network on the host.
# YTL_WEB_IP must lie inside the subnet but outside YTL_DOCKER_IP_RANGE (dynamic addresses).
YTL_DOCKER_SUBNET=172.30.57.0/24
YTL_DOCKER_IP_RANGE=172.30.57.128/25
YTL_WEB_IP=172.30.57.10

# Optional
YTL_DEMO_MODE=false
YTL_YOUTUBE_API_KEY=
# api | mock (offline demo data). Empty => mock in demo mode, api when a key is set
YTL_YOUTUBE_PROVIDER=
YTL_YOUTUBE_DAILY_QUOTA=10000
YTL_OPENAI_API_KEY=
YTL_OPENAI_VISION_MODEL=
YTL_VIBECODE_API_KEY=
# vibecode | openai | mock (offline demo results). Empty => mock in demo mode, else the provider whose key
# is set (vibecode first)
YTL_AI_PROVIDER=
YTL_THUMBNAIL_FETCHER=
YTL_WORKER_CONCURRENCY=2
YTL_LOG_LEVEL=INFO
